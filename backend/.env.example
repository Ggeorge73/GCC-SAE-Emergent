# Use MONGO_URL=memory for a throwaway in-process store (tests and demos only).
MONGO_URL=mongodb://localhost:27017
DB_NAME=law_suite
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
LAW_SUITE_AI_MODE=offline
CORS_ORIGINS=http://localhost:3000

# Synthetic-data local development only. Never expose this API through a proxy.
# Keep false until intentionally running a loopback-only demo.
LAW_SUITE_ALLOW_LOCAL_DEMO=false

# Signed-in sessions expire after this many hours.
LAW_SUITE_SESSION_HOURS=12
